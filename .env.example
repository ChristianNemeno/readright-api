# Authentication
API_KEY=your-secret-key-here

# WhisperX model configuration
# Size ladder (CPU, ascending cost/accuracy): tiny.en < base.en < small.en < medium.en
# transcriber.py pins language="en", so the English-only .en weights are strictly
# better than the multilingual ones at the same size. Move up a rung if ASR noise
# starts showing up as false miscues.
WHISPERX_MODEL=base.en
WHISPERX_DEVICE=cpu
# ctranslate2 precision. int8 is the lightest CPU option — roughly half the RAM of
# float32 and 2-4x faster, for little WER cost. Use float16 on cuda.
WHISPERX_COMPUTE_TYPE=int8

# Resource guards for a small always-on box (pilot: one reader at a time).
# Extra concurrent /analyze calls get 503 BUSY; oversized uploads get 413.
MAX_CONCURRENCY=1
MAX_UPLOAD_MB=40

# Supabase — use SERVICE key, not ANON key (service key bypasses RLS)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# CORS — JSON array of allowed origins
# Production: ALLOWED_ORIGINS=["https://readright.app","https://www.readright.app"]
# Local dev:  ALLOWED_ORIGINS=["http://localhost:5173"]
ALLOWED_ORIGINS=["http://localhost:5173"]

# ─── Deployment (docker-compose + Caddy) ─────────────────────────────────────
# Used by docker-compose.yml (interpolation) and the Caddyfile. Only needed on
# the deploy host, not for local `uvicorn` dev.
IMAGE=ghcr.io/christiannemeno/readright-api:latest
API_DOMAIN=api.readright.example.com   # a real domain pointed at the box; Caddy gets HTTPS for it
ACME_EMAIL=you@example.com             # Let's Encrypt account email
